{
  "name": "extention",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:scripts",
    "build:scripts": "esbuild src/scripts/content.ts --bundle --platform=browser --target=es2020 --outfile=dist/extention/browser/content.js && esbuild src/scripts/background.ts --bundle --platform=browser --target=es2020 --outfile=dist/extention/browser/background.js",
    "build:mozilla": "node scripts/build-firefox.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^1.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "archiver": "^8.0.0",
    "esbuild": "^0.21.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
